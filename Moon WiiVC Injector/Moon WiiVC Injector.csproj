<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Moon_WiiVC_Injector</RootNamespace>
    <AssemblyName>Moon WiiVC Injector</AssemblyName>
    <ApplicationIcon>WiiU.ico</ApplicationIcon>
    <NoWin32Manifest>true</NoWin32Manifest>
    <Description>Wii &amp; GameCube Virtual Console Injector for Wii U</Description>
    <RepositoryUrl>https://github.com/Rodrigo-Matsuura/TeconmoonWiiVCInjector</RepositoryUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <TrimMode Condition="'$(Configuration)' == 'Release'">partial</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(Configuration)' == 'Release'">true</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">none</AllowedReferenceRelatedFileExtensions>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <NeutralLanguage>en-US</NeutralLanguage>
    <NoWarn>$(NoWarn);IDE0130;CA2007;CA1031;CA5350;CA5351;CA1707;CA1062;CA1051;CA1305;CA1307;CA1308;CA1310;CA1711</NoWarn>
  </PropertyGroup>

  <!-- Platform-specific WIT tools packaging: embed only the target OS binary during publish to minimize executable size -->
  <PropertyGroup>
    <WitResourceFile>Resources\Tools\wit-all.zip</WitResourceFile>
    <WitResourceFile Condition="'$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').ToLowerInvariant().StartsWith('win'))">Resources\Tools\wit-win.zip</WitResourceFile>
    <WitResourceFile Condition="'$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').ToLowerInvariant().StartsWith('linux'))">Resources\Tools\wit-linux.zip</WitResourceFile>
    <WitResourceFile Condition="'$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').ToLowerInvariant().StartsWith('osx'))">Resources\Tools\wit-osx.zip</WitResourceFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NKit\NKit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(WitResourceFile)">
      <LogicalName>Moon_WiiVC_Injector.Resources.TOOLDIR.zip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\wiitdb.txt" />
    <EmbeddedResource Include="Resources\Base\**\*" />
    <EmbeddedResource Include="Resources\Dol\**\*" />
  </ItemGroup>
  <Target Name="RemoveNativePdbFilesFromPublish" AfterTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>

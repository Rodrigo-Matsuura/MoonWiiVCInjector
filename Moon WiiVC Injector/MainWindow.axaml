<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Moon_WiiVC_Injector.MainWindow"
        Title="Moon WiiVC Injector"
        Width="900"
        Height="680">
  <Grid RowDefinitions="Auto,Auto,*" Margin="12">
    <TextBlock Text="Avalonia port in progress" FontSize="24" FontWeight="Bold" />
    <Button Grid.Row="1" Content="Settings" Click="OnSettingsClick" Margin="0,12,0,12"/>
    <TextBlock Grid.Row="2" TextWrapping="Wrap">
      This application now starts with Avalonia on Linux and Windows.
      The legacy WinForms UI files are preserved for reference but excluded from compilation.
      Continue porting the existing UI and logic into Avalonia views and view models.
    </TextBlock>
  </Grid>
</Window>

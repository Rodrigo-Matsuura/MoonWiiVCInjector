<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Moon_WiiVC_Injector.MessageBoxWindow"
        Title="Message"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1e1e1e">
  <Grid RowDefinitions="*,Auto" Margin="16">
    <TextBlock Name="MessageText" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <StackPanel Name="ButtonsPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="OkButton" Content="OK" Width="80" HorizontalContentAlignment="Center" Click="OnOkClick" Background="#007acc" Foreground="White" IsVisible="False"/>
      <Button Name="YesButton" Content="Yes" Width="80" HorizontalContentAlignment="Center" Click="OnYesClick" Background="#007acc" Foreground="White" IsVisible="False"/>
      <Button Name="NoButton" Content="No" Width="80" HorizontalContentAlignment="Center" Click="OnNoClick" Background="#3a3a3a" Foreground="White" IsVisible="False"/>
    </StackPanel>
  </Grid>
</Window>

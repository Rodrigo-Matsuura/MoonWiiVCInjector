<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Moon_WiiVC_Injector.ViewModels"
        x:Class="Moon_WiiVC_Injector.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Application Settings"
        Width="440"
        Height="310"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#f0f0f0"
        Foreground="Black">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="16">
    <TextBlock Text="Banners Repository" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBox Grid.Row="1" Text="{Binding BannersRepository}" HorizontalAlignment="Stretch" Margin="0,0,0,14"/>
    
    <TextBlock Grid.Row="2" Text="Output Directory (leave empty to always ask)" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBox Text="{Binding OutputDir}" HorizontalAlignment="Stretch"/>
      <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOutputFolderCommand}" Width="84" HorizontalContentAlignment="Center" Margin="8,0,0,0"/>
    </Grid>

    <TextBlock Grid.Row="4" Text="Temporary Directory (leave empty for disk default)" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
      <TextBox Text="{Binding TempDir}" HorizontalAlignment="Stretch"/>
      <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseTempFolderCommand}" Width="84" HorizontalContentAlignment="Center" Margin="8,0,0,0"/>
    </Grid>

    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="accent" Content="OK" Command="{Binding SaveCommand}" Width="84" HorizontalContentAlignment="Center"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}" Width="84" HorizontalContentAlignment="Center"/>
    </StackPanel>
  </Grid>
</Window>

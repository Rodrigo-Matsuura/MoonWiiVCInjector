<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Moon_WiiVC_Injector.ViewModels"
        x:Class="Moon_WiiVC_Injector.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Application Settings"
        Width="400"
        Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1e1e1e">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="16">
    <TextBlock Text="Banners Repository" Foreground="White" Margin="0,0,0,4"/>
    <TextBox Grid.Row="1" Text="{Binding BannersRepository}" Width="368" HorizontalAlignment="Left" Background="#2d2d2d" Foreground="White" BorderBrush="#3f3f3f" Margin="0,0,0,16"/>
    
    <TextBlock Grid.Row="2" Text="Output Directory (leave empty to always ask)" Foreground="White" Margin="0,0,0,4"/>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
      <TextBox Text="{Binding OutputDir}" Width="280" HorizontalAlignment="Left" Background="#2d2d2d" Foreground="White" BorderBrush="#3f3f3f"/>
      <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOutputFolderCommand}" Width="80" HorizontalContentAlignment="Center" Background="#3a3a3a" Foreground="White" Margin="8,0,0,0"/>
    </Grid>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="OK" Command="{Binding SaveCommand}" Width="80" HorizontalContentAlignment="Center" Background="#007acc" Foreground="White"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" HorizontalContentAlignment="Center" Background="#3a3a3a" Foreground="White"/>
    </StackPanel>
  </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>14.0</LangVersion>
    <RootNamespace>NKit</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Description>Nintendo Kit</Description>
    <Copyright>Copyright © Nanook 2019</Copyright>
    <NoWarn>$(NoWarn);IDE0130;CA1819;CA1002;CA1063;CA1805;CA1027;CA1040;CA5401;CA1852;CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>
</Project>
